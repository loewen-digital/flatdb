{
  "name": "@loewen-digital/flatdb",
  "version": "0.2.1",
  "engines": {
    "node": "24"
  },
  "description": "Flat-file document database for TypeScript/JavaScript",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "vp check",
    "format": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test",
    "build": "vp pack",
    "prepack": "npm run build"
  },
  "keywords": [
    "database",
    "flat-file",
    "document-db",
    "json",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "nanoid": "^5.1.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.8.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loewen-digital/flatdb.git"
  },
  "bugs": {
    "url": "https://github.com/loewen-digital/flatdb/issues"
  },
  "homepage": "https://github.com/loewen-digital/flatdb#readme",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  }
}
